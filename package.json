{
  "name": "messenger",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "verify": "pnpm --filter web verify",
    "test:web": "pnpm --filter web test",
    "test:web:e2e": "pnpm --filter web test:e2e",
    "format:web": "pnpm --filter web format",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10"
  }
}
