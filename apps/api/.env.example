# Переменные бэкенда. Скопируйте в apps/api/.env — его читает ConfigModule при старте.
# Схема и значения по умолчанию — src/config/env.schema.ts. Переменные из окружения терминала важнее файла.

# Порт HTTP-сервера.
PORT=3001

# Адрес фронтенда, которому бэкенд разрешает запросы из браузера (CORS). Без пути и слэша в конце.
CORS_ORIGIN=http://localhost:3000
