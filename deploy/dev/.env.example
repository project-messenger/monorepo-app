# Copy outside the repository, e.g. /etc/messenger-dev/stack.env (chmod 600).
# Image built from the same commit as this configuration. Required; no latest.
API_IMAGE=
API_DOMAIN=api.example.com
CORS_ORIGIN=http://localhost:3000
POSTGRES_DB=messenger
POSTGRES_USER=messenger
# Required, no default password for the shared environment.
POSTGRES_PASSWORD=
# Absolute existing directory with fullchain.pem and privkey.pem.
TLS_CERTS_DIR=/etc/messenger-dev/tls
# For a local smoke test use 127.0.0.1, 18080 and 18443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
