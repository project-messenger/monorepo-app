# Turborepo Telemetry (1 to disable)
TURBO_TELEMETRY_DISABLED=1

# General tracking opt-out
DO_NOT_TRACK=1

# Переменные бэкенда. Скопируйте в .env — его читает ConfigModule при старте.
# Схема и значения по умолчанию — apps/api/src/config/env.schema.ts. Переменные из окружения терминала важнее файла.

# Порт HTTP-сервера.
PORT=3001

# Адрес фронтенда, которому бэкенд разрешает запросы из браузера (CORS). Без пути и слэша в конце.
CORS_ORIGIN=http://localhost:3000

# Локальная инфраструктура Docker Compose. Открытые примеры, не реальные секреты.
# База и пользователь создаются только при первом запуске с пустым volume.
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_local
# Порты на компьютере; порты внутри контейнеров остаются 5432 и 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Адреса для API, запущенного на компьютере разработчика.
POSTGRES_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_DB=0
# Порты Mailpit на компьютере: веб-интерфейс с письмами и SMTP для приложения.
# Внутри контейнера порты остаются 8025 и 1025.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
